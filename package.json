{
  "name": "vuetify_rules",
  "version": "0.7.0",
  "description": "Rules and functions necessary to validate forms in vuetify",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./rules": {
      "types": "./index.d.ts",
      "import": "./src/rules.js"
    },
    "./functions": {
      "types": "./index.d.ts",
      "import": "./src/functions.js"
    },
    "./singleton": {
      "import": "./src/singleton.js"
    },
    "./locales": {
      "import": "./locales/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/turulomio/vuetify_rules.git"
  },
  "keywords": [
    "vuetify",
    "rules",
    "forms",
    "validation"
  ],
  "author": "Turulomio",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/turulomio/vuetify_rules/issues"
  },
  "homepage": "https://github.com/turulomio/vuetify_rules#readme",
  "dependencies": {},
  "scripts": {
    "test": "node --test test/*.test.js",
    "coverage": "node --test --experimental-test-coverage test/*.test.js",
    "start": "node index.js",
    "release": "node src/script_release.js",
    "i18n:extract": "i18next 'src/**/*.{js,vue}'"
  },
  "devDependencies": {
    "i18next-parser": "^9.0.0",
    "npm-check-updates": "^16.14.20"
  }
}
